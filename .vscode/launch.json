{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/zero-to-tech-4-1/backend",
      "python": "${workspaceFolder}/zero-to-tech-4-1/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "FastAPI: main.py",
      "type": "debugpy",
      "request": "launch",
      "module": "granian",
      "args": [
        "--interface",
        "asgi",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "main:app"
      ],
      "cwd": "${workspaceFolder}/zero-to-tech-4-1/backend",
      "python": "${workspaceFolder}/zero-to-tech-4-1/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
